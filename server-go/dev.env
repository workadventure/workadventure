# Loaded by `dev/dev stack up go --variant server` (dev/README.md, "Contract of the server variant").
# Single quotes: expanded in the container. The server reads the pusher's port variables.
SERVER_COMMAND='export GOCACHE=/cache/go GOMODCACHE=/cache/gomod PUSHER_HTTP_PORT=$SERVER_HTTP_PORT PUSHER_WS_PORT=$SERVER_WS_PORT && exec air -c .air.toml'
