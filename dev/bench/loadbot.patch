+func durations(s string) (time.Duration, time.Duration) {
+	a, b, _ := strings.Cut(s, ",")
+	lo, err1 := time.ParseDuration(a)
+	hi, err2 := time.ParseDuration(b)
+	if err1 != nil || err2 != nil || hi < lo {
+		fmt.Fprintln(os.Stderr, "expected two durations, e.g. 3s,10s:", s)
+		os.Exit(2)
+	}
+	return lo, hi
+}
+
+// walk decides when a bot moves: always (walk profile), or in bursts separated by pauses (realistic profile).
+type walk struct {
+	always                                 bool
+	burstMin, burstMax, pauseMin, pauseMax time.Duration
+	walking                                bool
+	until                                  time.Time
+}
+
+func between(lo, hi time.Duration) time.Duration {
+	if hi <= lo {
+		return lo
+	}
+	return lo + rand.N(hi-lo)
+}
+
+// step returns whether to move now, and whether a walk just ended (the bot then sends a stop).
+func (w *walk) step(now time.Time) (move, stopped bool) {
+	if w.always {
+		return true, false
+	}
+	if w.until.IsZero() { // desynchronise the walkers: start in the middle of a pause
+		w.until = now.Add(between(0, w.pauseMax))
+	}
+	if now.Before(w.until) {
+		return w.walking, false
+	}
+	w.walking = !w.walking
+	if w.walking {
+		w.until = now.Add(between(w.burstMin, w.burstMax))
+		return true, false
+	}
+	w.until = now.Add(between(w.pauseMin, w.pauseMax))
+	return false, true
+}
