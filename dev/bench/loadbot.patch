+// storm cuts the connection without a closing handshake, waits -storm-down, then tries to resume the session as
+// the front does. A refused resume is followed by a full reconnection. kick sends the bot's position again: every
+// bot comes back at the same time, and without moves nobody would receive anything to tell a resumed session.
+func (b *bot) storm(ctx context.Context, st *stats, done chan error, token, httpBase, wsBase, roomURL string, kick func() error) (chan error, error) {
+	b.conn.CloseNow()
+	<-done
+	select {
+	case <-ctx.Done():
+		return nil, ctx.Err()
+	case <-time.After(*stormDown):
+	}
+	t := time.Now()
+	last := b.lastNonce.Load()
+	done, err := b.dial(ctx, st, token, wsBase, roomURL, last)
+	if err == nil {
+		_ = kick() // on a session that is not resumed, the server closes it or ignores the move
+		closed := false
+		select {
+		case n := <-b.firstFrame:
+			if n > last { // the server replays where we left: same session
+				st.resumed.Add(1)
+				st.returnTime.add(time.Since(t).Milliseconds())
+				return done, nil
+			}
+		case <-done: // closed: 1008 (frames missing) or 4000 (session destroyed)
+			closed = true
+		case <-time.After(5 * time.Second): // a new, empty session waiting for a join
+		}
+		if !closed { // one reader at a time: it owns b.seen
+			b.conn.CloseNow()
+			<-done
+		}
+	}
+	st.refused.Add(1)
+	b.connectionID += "-new"
+	done, err = b.connect(ctx, st, httpBase, wsBase, roomURL)
+	if err != nil {
+		st.lost.Add(1)
+		return nil, err
+	}
+	st.rejoined.Add(1)
+	st.returnTime.add(time.Since(t).Milliseconds())
+	return done, nil
+}
