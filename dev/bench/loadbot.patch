+// histogram of milliseconds, fixed size: storing millions of samples made the generator's own garbage
+// collection show up in the latencies it measures.
+type histogram [histogramMax + 1]atomic.Int64
+
+func (h *histogram) add(ms int64) { h[min(max(ms, 0), histogramMax)].Add(1) }
+
+func (h *histogram) quantiles() (total int64, q func(float64) float64) {
+	for i := range h {
+		total += h[i].Load()
+	}
+	return total, func(p float64) float64 {
+		rank, seen := int64(p*float64(total-1)), int64(0)
+		for ms := range h {
+			if seen += h[ms].Load(); seen > rank {
+				return float64(ms)
+			}
+		}
+		return 0
+	}
