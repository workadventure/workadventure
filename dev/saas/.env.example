# Example for dev/saas. up.sh copies it to dev/saas/.env on the first run. Local-only values, no real secret.
# Shared between the admin and the Go server:
ADMIN_API_TOKEN=local-admin-api-token
ADMIN_SOCKETS_TOKEN=local-admin-sockets-token
SECRET_KEY=local-secret-key-for-jwt
MAP_STORAGE_API_TOKEN=local-map-storage-api-token
# Admin -> Go map-storage (the Go server's AUTHENTICATION_TOKEN)
MAP_STORAGE_AUTHENTICATION_TOKEN=local-map-storage-bearer
# OIDC client "1" of the admin, used by the Go server
OPENID_CLIENT_SECRET=local-openid-client-secret

# --- The rest feeds the SaaS docker-compose.yaml (copied from .env.template, local defaults) ---
HOST_NAME=admin.workadventure.localhost
SELF_HOSTED=false
FRONT_URL=play.workadventure.localhost
SHOWCASE_URL=https://workadventu.re
APP_NAME=workadventure
START_ROOM_URL=/_/global/maps.workadventure.localhost/starter/map.json
DEBUG_MODE=false
DISABLE_NOTIFICATIONS=true
SKIP_RENDER_OPTIMIZATIONS=false
JITSI_URL=meet.jit.si
JITSI_PRIVATE_MODE=true
STUN_SERVER=stun:stun.l.google.com:19302
TURN_SERVER_TYPE=default
AWS_ACCESS_KEY_ID=local-s3-access-key
AWS_SECRET_ACCESS_KEY=local-s3-secret-key
AWS_DEFAULT_REGION=eu-west-1
AWS_BUCKET=workadventure-bucket
AWS_ENDPOINT=http://cdn.workadventure.localhost/
AWS_URL=http://rustfs:9000
STRIPE_ENV=staging
TESTNET=true
ENABLE_HARD_LIMITS=true
ENABLE_CHAT=false
ENABLE_MAP_EDITOR=true
UPLOAD_MAX_FILESIZE=10485760
UPLOADER_REDIS_HOST=redis
UPLOADER_REDIS_PORT=6379
LIVEKIT_HOST=http://livekit.workadventure.localhost
COMPOSE_PROJECT_NAME=wa-saas-go



# Left empty on purpose (interpolated by the SaaS compose file)
AZURE_OPENAI_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_TURN_KEY_API_TOKEN=
CLOUDFLARE_TURN_KEY_ID=
CURRENT_K8S_NAMESPACE=
ENABLE_CHAT_ONLINE_LIST=
GOOGLE_CALENDAR_TOKEN=
KUBECONFIG_CONTEXT=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_PRO_API_KEY=
LIVEKIT_PRO_API_SECRET=
LIVEKIT_PRO_HOST=
LIVEKIT_RECORDING_S3_ACCESS_KEY=
LIVEKIT_RECORDING_S3_BUCKET=
LIVEKIT_RECORDING_S3_CDN_ENDPOINT=
LIVEKIT_RECORDING_S3_ENDPOINT=
LIVEKIT_RECORDING_S3_REGION=
LIVEKIT_RECORDING_S3_SECRET_KEY=
MAILJET_APIKEY=
MAILJET_APISECRET=
METAMASK_LOGIN_ENABLED=
OPENAI_KEY=
PIPEDRIVE_API_TOKEN=
PIPEDRIVE_DOMAIN=
POSTHOG_API_KEY=
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_URL=
PROMETHEUS_AUTHORIZATION_TOKEN=
PUSHER_APP_CLUSTER=
PUSHER_APP_KEY=
SERVER_ID=
