{
    "name": "workadventure-desktop",
    "productName": "WorkAdventure",
    "version": "managedbyci",
    "description": "Desktop application for WorkAdventure",
    "author": "TheCodingMachine <hello@workadventu.re>",
    "homepage": "https://workadventu.re",
    "main": "dist/main.js",
    "license": "SEE LICENSE IN LICENSE.txt",
    "scripts": {
        "build": "tsup-node ./src/main.ts ./src/preload-app/preload.ts ./src/preload-hud/preload.ts ./src/preload-tabs/preload.ts ./src/preload-screen-identify/preload.ts",
        "dev": "npm run build -- --watch --onSuccess 'electron dist/main.js'",
        "bundle": "npm run build && electron-builder install-app-deps && electron-builder",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "e2e": "playwright test",
        "lint": "eslint . --ext .ts",
        "fix": "eslint --fix . --ext .ts",
        "pretty": "prettier --write 'src/**/*.{ts,tsx}' 'tests/**/*.ts' '*.config.ts'",
        "pretty-check": "prettier --check 'src/**/*.{ts,tsx}' 'tests/**/*.ts' '*.config.ts'"
    },
    "dependencies": {
        "auto-launch": "^5.0.5",
        "electron-is-dev": "^2.0.0",
        "electron-log": "^4.4.6",
        "electron-settings": "^4.0.2",
        "electron-updater": "^6.8.10",
        "electron-util": "^0.17.2",
        "electron-window-state": "^5.0.3",
        "node-fetch": "^3.2.10"
    },
    "devDependencies": {
        "@playwright/test": "^1.63.0",
        "@types/auto-launch": "^5.0.2",
        "@types/node": "^24.9.0",
        "@typescript-eslint/eslint-plugin": "^8.60.0",
        "@typescript-eslint/parser": "^8.60.0",
        "electron": "^42.4.1",
        "electron-builder": "^26.15.3",
        "eslint": "^8.57.1",
        "prettier": "^2.6.2",
        "tsup": "^5.12.4",
        "typescript": "^5.9.3",
        "vitest": "^4.1.7"
    }
}
