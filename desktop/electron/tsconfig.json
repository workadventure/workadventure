{
  "compilerOptions": {
    "experimentalDecorators": true,
    "target": "es5",
    "downlevelIteration": true,
    "module": "commonjs",
    "allowJs": true,
    "sourceMap": true,
    "outDir": "./dist",
    "strict": true,
    "noImplicitThis": false,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "moduleResolution": "node",
    //"baseUrl": ".",
    //"paths": {},
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  // The tests are plain JS run by vitest and Playwright, whose typings need a newer TypeScript than this one.
  "exclude": ["node_modules", "dist", "build", "src/**/*.test.js", "e2e", "playwright.config.js"]
}
